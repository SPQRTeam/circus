<mujoco>
    <!--
        Every class, material and mesh below is prefixed with "Booster-T2" because all
        robot common.xml files are included in the same scene: unprefixed names would
        collide with the Booster-T1 ones as soon as a scene mixes the two robots.
    -->
    <default>
        <default class="Booster-T2">
            <!--
                Damping now is default (i.e. 0). To check if it is ok or not
            -->
            <joint limited="true" armature="0.01" frictionloss="0.0" />
            <equality solref="0.001 2" />

            <default class="Booster-T2_visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
            </default>

            <default class="Booster-T2_collision">
                <geom group="3" material="Booster-T2_transparent" priority="1" friction="1. 0.01 0.005"/>
            </default>
        </default>
    </default>

    <asset>
        <!-- The real T2's colors. The visor, hands, neck, trunk bottom, back buttons and port, knee plates and calf
             pads are cut out of their link's mesh into meshes of their own, so they can have their own color. The neck
             and the trunk bottom are the parts they are on the real T2, cut through the wall along their seams, and the
             rest of Booster's meshes is as it was. The torso is the shell's material in pearl white, as on the real T2,
             wherever SceneParser doesn't paint it with the team color. -->
        <material name="Booster-T2_light" rgba="0.25 0.24 0.235 1" specular="0.4" shininess="0.4"/>
        <material name="Booster-T2_pearl" rgba="0.85 0.85 0.86 1" specular="0.4" shininess="0.4"/>
        <material name="Booster-T2_head" rgba="0.2 0.19 0.185 1" specular="0.4" shininess="0.4"/>
        <material name="Booster-T2_visor" rgba="0.03 0.03 0.035 1" specular="1" shininess="0.9"/>
        <material name="Booster-T2_dark" rgba="0.1 0.1 0.1 1" specular="0.05" shininess="0.2"/>
        <material name="Booster-T2_white" rgba="1 1 1 1"/>
        <material name="Booster-T2_transparent" rgba="0.5 0.5 0.5 1"/>

        <mesh name="Booster-T2_trunk" file="Booster-T2/trunk.STL" />
        <mesh name="Booster-T2_neck" file="Booster-T2/neck.STL" />
        <mesh name="Booster-T2_trunk_bottom" file="Booster-T2/trunk_bottom.STL" />
        <mesh name="Booster-T2_back_buttons" file="Booster-T2/back_buttons.STL" />
        <mesh name="Booster-T2_logo" file="Booster-T2/logo.STL" />
        <mesh name="Booster-T2_head_yaw_link" file="Booster-T2/head_yaw_link.STL" />
        <mesh name="Booster-T2_head_pitch_link" file="Booster-T2/head_pitch_link.STL" />
        <mesh name="Booster-T2_head_visor" file="Booster-T2/head_visor.STL" />
        <mesh name="Booster-T2_head_pitch_link_collision" file="Booster-T2/head_pitch_link_collision.STL" />
        <mesh name="Booster-T2_left_shoulder_pitch_link" file="Booster-T2/left_shoulder_pitch_link.STL" />
        <mesh name="Booster-T2_left_shoulder_roll_link" file="Booster-T2/left_shoulder_roll_link.STL" />
        <mesh name="Booster-T2_left_elbow_pitch_link" file="Booster-T2/left_elbow_pitch_link.STL" />
        <mesh name="Booster-T2_left_elbow_yaw_link" file="Booster-T2/left_elbow_yaw_link.STL" />
        <mesh name="Booster-T2_left_wrist_pitch_link" file="Booster-T2/left_wrist_pitch_link.STL" />

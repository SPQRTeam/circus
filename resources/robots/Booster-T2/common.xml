        <mesh name="Booster-T2_left_wrist_roll_link_with_hand" file="Booster-T2/left_wrist_roll_link_with_hand.STL" />
        <mesh name="Booster-T2_left_hand" file="Booster-T2/left_hand.STL" />
        <mesh name="Booster-T2_left_wrist_roll_link_collision" file="Booster-T2/left_wrist_roll_link_collision.STL" />
        <mesh name="Booster-T2_right_shoulder_pitch_link" file="Booster-T2/right_shoulder_pitch_link.STL" />

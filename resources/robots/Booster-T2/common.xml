<mujoco>
    <!--
        Every class, material and mesh below is prefixed with "Booster-T2" because all
        robot common.xml files are included in the same scene: unprefixed names would
        collide with the Booster-T1 ones as soon as a scene mixes the two robots.
    -->
    <default>
        <default class="Booster-T2">
            <!--
                Damping now is default (i.e. 0). To check if it is ok or not
            -->
            <joint limited="true" armature="0.01" frictionloss="0.0" />
            <equality solref="0.001 2" />

            <default class="Booster-T2_visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/>
            </default>

            <default class="Booster-T2_collision">
                <geom group="3" material="Booster-T2_transparent" priority="1" friction="1. 0.01 0.005"/>
            </default>
        </default>
    </default>

    <asset>
        <material name="Booster-T2_light" rgba="0.847 0.847 0.847 1"/>
        <material name="Booster-T2_dark" rgba="0.2078 0.2078 0.2078 1"/>
        <material name="Booster-T2_white" rgba="1 1 1 1"/>
        <material name="Booster-T2_transparent" rgba="0.5 0.5 0.5 1"/>

        <mesh name="Booster-T2_trunk" file="Booster-T2/trunk.STL" />
        <mesh name="Booster-T2_logo" file="Booster-T2/logo.STL" />
        <mesh name="Booster-T2_head_yaw_link" file="Booster-T2/head_yaw_link.STL" />
